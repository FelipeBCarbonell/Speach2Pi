# Copie para .env e preencha (o .env nao vai para o git)

# --- APIs ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
NVIDIA_API_KEY=nvapi-...

# Qual provedor usar para gerar o codigo: openai | anthropic | nvidia
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Exemplo com a NVIDIA:
# LLM_PROVIDER=nvidia
# LLM_MODEL=moonshotai/kimi-k3

# Transcricao (speech-to-text)
STT_PROVIDER=openai
STT_MODEL=whisper-1
# Exemplo com a NVIDIA (whisper-large-v3 no build.nvidia.com, usa a NVIDIA_API_KEY):
# STT_PROVIDER=nvidia
# STT_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# STT_LANGUAGE=pt

# --- Robo Pololu Zumo 2040 ---
# Porta serial do MicroPython (ex.: COM9). "auto" procura o Zumo pela USB.
ROBOT_PORT=auto
