# Copie para .env e preencha (o .env nao vai para o git)

# --- APIs ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Qual provedor usar para gerar o codigo: openai | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Transcricao (speech-to-text)
STT_PROVIDER=openai
STT_MODEL=whisper-1

# --- Raspberry Pi ---
PI_HOST=raspberrypi.local
PI_USER=pi
PI_REMOTE_DIR=/home/pi/speach2pi

# --- Hardware (pinos BCM) ---
LED_PIN=17
BUTTON_PIN=27
